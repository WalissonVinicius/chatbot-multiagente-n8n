    {
      "parameters": {
        "jsCode": "const PERFIS = {\n  comercial: 'Você ajuda o cliente a escolher e contratar um plano.',\n  financeiro: 'Você resolve dúvidas de boletos, pagamentos e vencimentos.',\n  suporte: 'Você ajuda o cliente a resolver problemas de conexão, um passo de cada vez.',\n};\n\nconst conversa = $('Ler triagem').first().json;\nconst faq = $input.all().map((item) => item.json).filter((row) => row.pergunta);\n\nconst system = [\n  `Você é o agente ${conversa.setor} do Provedor Exemplo e atende clientes pelo WhatsApp.`,\n  PERFIS[conversa.setor],\n  'Regras:',\n  '- Responda em português, em até 3 frases curtas e com tom cordial.',\n  '- Use só as informações do FAQ abaixo. Se a resposta não estiver nele, não invente: transfira para a equipe.',\n  '- Transfira também se o cliente pedir uma pessoa ou estiver irritado.',\n  'FAQ:',\n  ...faq.map((row) => `P: ${row.pergunta}\\nR: ${row.resposta}`),\n  'Responda só com JSON: {\"resposta\": \"texto para o cliente\", \"transferir\": true ou false}',\n].join('\\n');\n\nconst body = {\n  model: $env.OPENAI_MODEL || 'gpt-5-mini',\n  response_format: { type: 'json_object' },\n  messages: [\n    { role: 'system', content: system },\n    ...conversa.historico.map(({ role, content }) => ({ role, content })),\n    { role: 'user', content: conversa.text },\n  ],\n};\n\nreturn [{ json: { ...conversa, body } }];"
      },
      "id": "df7f4100-ffb0-4ba6-a9ec-b73411a6fe59",
      "name": "Montar agente",
      "type": "n8n-nodes-base.code",
