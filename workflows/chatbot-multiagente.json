    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE mensagens SET processed = true\nWHERE conversation_id = $1 AND role = 'user' AND NOT processed\nRETURNING id, content;",
        "options": {
          "queryReplacement": "={{ [ $('Validar entrada').first().json.conversationId ] }}"
        }
