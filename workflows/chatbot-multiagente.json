    {
      "parameters": {
        "jsCode": "const caso = $json;\n\nreturn [{\n  json: {\n    conversationId: caso.conversationId,\n    setor: caso.setor,\n    resumo: caso.resumo,\n    historico: caso.historico ?? [],\n    text: caso.resposta || 'Vou te passar para a nossa equipe. Já mandei um resumo da conversa, então você não precisa repetir nada.',\n  },\n}];"
      },
