      "parameters": {
        "jsCode": "// Chega aqui pela resposta do agente ou depois de uma transferência.\nconst transferiu = $('Preparar transferência').isExecuted;\nconst caso = transferiu\n  ? $('Preparar transferência').first().json\n  : { conversationId: $json.conversationId, text: $json.resposta };\n\nreturn [{ json: { conversationId: caso.conversationId, text: caso.text } }];"
      },
