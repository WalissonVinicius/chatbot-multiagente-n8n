    {
      "parameters": {
        "jsCode": "const entrada = $('Validar entrada').first().json;\nlet text = entrada.text;\n\nif (entrada.type === 'audio') {\n  const transcricao = $('Transcrever áudio').first().json.text;\n  text = typeof transcricao === 'string' && transcricao.trim()\n    ? transcricao.trim()\n    : '(o cliente mandou um áudio que não deu para transcrever)';\n}\n\nreturn [{ json: { conversationId: entrada.conversationId, text } }];"
      },
      "id": "c295f7fb-0865-4aac-a58b-18102ca84ef5",
      "name": "Texto da mensagem",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
