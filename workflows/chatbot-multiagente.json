    {
      "parameters": {
        "jsCode": "// Formato esperado do corpo:\n// { \"conversationId\": \"5566999990000\", \"type\": \"text\" | \"audio\", \"text\": \"...\", \"audioUrl\": \"https://...\", \"messageId\": \"opcional\" }\nconst body = $input.first().json.body ?? {};\nconst conversationId = String(body.conversationId ?? '').trim();\nconst type = body.type ?? 'text';\nconst text = typeof body.text === 'string' ? body.text.trim() : '';\nconst audioUrl = typeof body.audioUrl === 'string' ? body.audioUrl : '';\nconst errors = [];\n\nif (!/^[\\w.@+-]{1,64}$/.test(conversationId)) errors.push('conversationId inválido');\nif (!['text', 'audio'].includes(type)) errors.push('type deve ser \"text\" ou \"audio\"');\nif (type === 'text' && !text) errors.push('text vazio');\nif (type === 'audio' && !/^https?:\\/\\//.test(audioUrl)) errors.push('audioUrl inválida');\nif (text.length > 4000) errors.push('text passa de 4000 caracteres');\n\nreturn [{\n  json: {\n    valid: errors.length === 0,\n    errors,\n    conversationId,\n    type,\n    text,\n    audioUrl,\n    // Sem messageId, cada entrega conta como mensagem nova.\n    messageId: String(body.messageId ?? $execution.id),\n  },\n}];"
      },
