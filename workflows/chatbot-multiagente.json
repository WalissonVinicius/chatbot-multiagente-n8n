    {
      "parameters": {
        "jsCode": "// Junta tudo o que o cliente mandou durante a espera em um texto só.\nconst rows = $input.all().map((item) => item.json).filter((row) => row.id);\nif (rows.length === 0) return [];\n\nrows.sort((a, b) => Number(a.id) - Number(b.id));\n\nreturn [{\n  json: {\n    conversationId: $('Validar entrada').first().json.conversationId,\n    text: rows.map((row) => row.content).join('\\n'),\n    firstId: Number(rows[0].id),\n  },\n}];"
      },
      "id": "bc4350e0-4d68-4cc6-a495-64e8eb20e2af",
      "name": "Juntar mensagens",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        800
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT role, content FROM (\n  SELECT id, role, content FROM mensagens\n  WHERE conversation_id = $1 AND processed AND id < $2\n  ORDER BY id DESC\n  LIMIT 10\n) ultimas\nORDER BY id;",
        "options": {
          "queryReplacement": "={{ [ $json.conversationId, $json.firstId ] }}"
        }
      },
      "id": "c62710dc-437e-4529-a90e-63d74942b2cc",
      "name": "Buscar histórico",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        440,
        800
      ],
      "credentials": {
        "postgres": {
          "id": "chatbotPostgres1",
          "name": "Postgres local"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const TRIAGEM = [\n  '[TRIAGEM] Você faz a triagem do atendimento do Provedor Exemplo, um provedor de internet.',\n  'Leia a conversa e escolha o setor da última mensagem do cliente:',\n  '- comercial: planos, preços, contratação, instalação, cobertura, mudança de plano.',\n  '- financeiro: boletos, faturas, pagamentos, vencimento, desbloqueio.',\n  '- suporte: internet lenta ou caindo, Wi-Fi, senha, equipamentos, visita técnica.',\n  '- humano: o cliente pede uma pessoa, faz uma reclamação grave ou o assunto não cabe nos outros setores.',\n  'Responda só com JSON: {\"setor\": \"comercial | financeiro | suporte | humano\", \"resumo\": \"uma frase com o pedido do cliente\"}',\n].join('\\n');\n\nconst conversa = $('Juntar mensagens').first().json;\nconst historico = $input.all().map((item) => item.json).filter((row) => row.role && row.content);\n\nconst body = {\n  model: $env.OPENAI_MODEL || 'gpt-5-mini',\n  response_format: { type: 'json_object' },\n  messages: [\n    { role: 'system', content: TRIAGEM },\n    ...historico.map(({ role, content }) => ({ role, content })),\n    { role: 'user', content: conversa.text },\n  ],\n};\n\nreturn [{ json: { ...conversa, historico, body } }];"
      },
      "id": "45109879-4143-4c2d-a1d4-06d78f329707",
      "name": "Montar triagem",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        800
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OPENAI_BASE_URL }}/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.OPENAI_API_KEY }}"
            }
