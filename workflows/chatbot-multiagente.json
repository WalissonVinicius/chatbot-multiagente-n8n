    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT pergunta, resposta FROM faq\nWHERE setor = $1\nORDER BY ts_rank(busca, replace(plainto_tsquery('portuguese', $2)::text, '&', '|')::tsquery) DESC, id\nLIMIT 3;",
        "options": {
          "queryReplacement": "={{ [ $json.setor, $json.text ] }}"
        }
      },
