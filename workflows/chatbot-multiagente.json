      },
      "id": "962898a1-a728-4e7c-aea0-163c98f55a53",
      "name": "Triagem",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        800
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const conversa = $('Montar triagem').first().json;\nconst SETORES = ['comercial', 'financeiro', 'suporte', 'humano'];\n\nlet triagem = {};\ntry {\n  triagem = JSON.parse($json.choices[0].message.content);\n} catch {\n  triagem = {};\n}\n\n// Resposta fora do formato vira transferência: melhor uma pessoa do que um chute.\nconst setor = SETORES.includes(triagem.setor) ? triagem.setor : 'humano';\n\nreturn [{\n  json: {\n    conversationId: conversa.conversationId,\n    text: conversa.text,\n    historico: conversa.historico,\n    setor,\n    resumo: String(triagem.resumo || conversa.text).slice(0, 500),\n  },\n}];"
      },
      "id": "eefc6be3-2c9c-48e9-af50-bf64490c3ff3",
      "name": "Ler triagem",
