    {
      "parameters": {
        "jsCode": "// A IA falhou mesmo depois das novas tentativas: a conversa vai para uma pessoa.\nconst conversa = $('Juntar mensagens').first().json;\n\nreturn [{\n  json: {\n    conversationId: conversa.conversationId,\n    setor: 'humano',\n    resumo: `A IA não respondeu. Última mensagem do cliente: ${conversa.text}`.slice(0, 500),\n    historico: [],\n    resposta: '',\n  },\n}];"
      },
