      "id": "2c3b195f-9270-403f-a544-75186cdd837d",
      "name": "Agente do setor",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1980,
        800
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const conversa = $('Montar agente').first().json;\n\nlet saida = {};\ntry {\n  saida = JSON.parse($json.choices[0].message.content);\n} catch {\n  saida = {};\n}\n\nconst resposta = typeof saida.resposta === 'string' ? saida.resposta.trim() : '';\n\nreturn [{\n  json: {\n    conversationId: conversa.conversationId,\n    setor: conversa.setor,\n    resumo: conversa.resumo,\n    historico: conversa.historico,\n    resposta,\n    // Sem resposta válida, quem responde é a equipe.\n    transferir: saida.transferir === true || !resposta,\n  },\n}];"
      },
