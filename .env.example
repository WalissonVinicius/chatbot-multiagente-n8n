# Chave que o n8n usa para criptografar as credenciais. Gere uma com: openssl rand -hex 24
N8N_ENCRYPTION_KEY=

# API da OpenAI ou outro serviço compatível com ela.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TRANSCRIBE_MODEL=whisper-1

# Para onde o chatbot envia cada resposta: POST { conversationId, text }
REPLY_URL=
# Para onde vai a transferência para a equipe: POST { conversationId, setor, resumo, historico }
HANDOFF_URL=

# Quantos segundos esperar o cliente parar de digitar antes de responder.
DEBOUNCE_SECONDS=15
